": null, "endBinding": null, "startArrowhead": null, "endArrowhead": "arrow", "elbowed": false, "lastCommittedPoint": null}, {"id": "7ngy2k5fwhbl", "type": "text", "x": 2488, "y": 5074.25, "width": 7.280000000000001, "height": 16.25, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 434521668, "version": 1, "versionNonce": 908266225, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "N", "originalText": "N", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "tj9ijimfqq5t", "type": "text", "x": 2488, "y": 4444.0, "width": 7.280000000000001, "height": 16.25, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 687843594, "version": 1, "versionNonce": 430262741, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "1", "originalText": "1", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "ftdau8es0fe6", "type": "rectangle", "x": 30, "y": 5969.0, "width": 2780, "height": 230, "angle": 0, "strokeColor": "#495057", "backgroundColor": "#f8f9fa", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 635541691, "version": 1, "versionNonce": 853938869, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "h8v7njlo0jw9", "type": "text", "x": 50, "y": 5983.0, "width": 1696.8000000000002, "height": 168.75, "angle": 0, "strokeColor": "#343a40", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 194692738, "version": 1, "versionNonce": 409708965, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Relationship notes\n- A user can be a seeker, landlord, agent or officer through user_roles; organizations act through org_members (authorized representative).\n- properties 1:N listings over time; a listing has many versioned landlord_terms; interests pin the exact terms_id accepted (acceptance record = terms_id + terms_accepted_at).\n- One interest > one character_report (provider-supplied, encrypted) > many report_access_logs (every landlord read is logged).\n- One approved interest > inspections (retries allowed) > one inspection_report. Admin assigns officer_id manually in the MVP.\n- Transaction chain: interests > agreements (versioned template) > payments (idempotent) > settlements (landlord amount + platform fee); webhook_events dedupes provider callbacks.\n- Tenancy chain: agreements > tenancies > rent_schedules > rent_payments (ledger, linked to payments). legal_cases is post-MVP.\n- Polymorphic links (verifications.subject_*, documents.owner_*, messages/notifications.related_*, audit_logs.entity_*) carry the owning table + id; the owning-table FK is enforced in the service layer.\n- Ghost \"users (ref)\" boxes repeat the users table so FK arrows stay readable; they all point to users.id.", "originalText": "Relationship notes\n- A user can be a seeker, landlord, agent or officer through user_roles; organizations act through org_members (authorized representative).\n- properties 1:N listings over time; a listing has many versioned landlord_terms; interests pin the exact terms_id accepted (acceptance record = terms_id + terms_accepted_at).\n- One interest > one character_report (provider-supplied, encrypted) > many report_access_logs (every landlord read is logged).\n- One approved interest > inspections (retries allowed) > one inspection_report. Admin assigns officer_id manually in the MVP.\n- Transaction chain: interests > agreements (versioned template) > payments (idempotent) > settlements (landlord amount + platform fee); webhook_events dedupes provider callbacks.\n- Tenancy chain: agreements > tenancies > rent_schedules > rent_payments (ledger, linked to payments). legal_cases is post-MVP.\n- Polymorphic links (verifications.subject_*, documents.owner_*, messages/notifications.related_*, audit_logs.entity_*) carry the owning table + id; the owning-table FK is enforced in the service layer.\n- Ghost \"users (ref)\" boxes repeat the users table so FK arrows stay readable; they all point to users.id.", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}], "appState": {"viewBackgroundColor": "#ffffff", "gridSize": null}, "files": {}}