PORT=5050
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rentrust?schema=public
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d
CLIENT_URL=http://localhost:5173
# Show email/phone codes and reset links on screen (on locally; set true on a hosted beta)
# TEST_MODE=true
# Proxies in front of the API on the host (usually 1 when hosted, 0 locally)
TRUST_PROXY=0
# How long the simulated character-report provider takes (ms)
REPORT_DELAY_MS=4000
# Email through Resend. EMAIL_FROM must use a domain verified in Resend. Leave both empty to simulate email.
RESEND_API_KEY=
EMAIL_FROM="RENTrust <no-reply@mail.rentrust.ng>"
# Listing photos on Cloudinary (Settings → API Keys). Leave empty to switch photo uploads off.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
