{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd server && npm run dev"
      ],
      "port": 5050
    },
    {
      "name": "api-preview-db",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd server && set -a && . ./.env && set +a && DATABASE_URL=\"${DATABASE_URL%/*}/rentrust_preview\" PORT=5097 RESEND_API_KEY= CLIENT_URL=http://localhost:5174 npx tsx index.ts"
      ],
      "port": 5097
    },
    {
      "name": "web",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd web && npm run dev"
      ],
      "port": 5173
    },
    {
      "name": "web-preview-db",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd web && VITE_API_URL=http://localhost:5097/api/v1 npx vite --port 5174 --strictPort"
      ],
      "port": 5174
    }
  ]
}
